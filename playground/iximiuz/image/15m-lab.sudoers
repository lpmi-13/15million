laborant ALL=(root) NOPASSWD: /opt/15m-lab/toolbox/runtime.sh *, /opt/15m-lab/toolbox/reset.sh, /opt/15m-lab/toolbox/bounded.sh *, /usr/sbin/ip netns add 15m-ports, /usr/sbin/ip -n 15m-ports link set lo up, /usr/sbin/ip netns exec 15m-ports /opt/15m-lab/baseline/bin/port_exhaust 15000000, /usr/sbin/ip netns del 15m-ports, /usr/sbin/ip -6 route add local 2001\:db8\:1234\:5678\:\:/64 dev lo, /usr/sbin/sysctl -w net.ipv6.ip_nonlocal_bind=1
